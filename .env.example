# Copy this file to .env for local development. Never commit real secrets.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: registers commands only in this server for faster development.
DISCORD_GUILD_ID=


# GuildNest web Discord OAuth (set these in Vercel or your local environment)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Generate a random value of at least 32 characters; do not use this example as a production secret.
SESSION_SECRET=

# Optional ticket configuration for NestMate
TICKET_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=
TICKET_LOG_CHANNEL_ID=
