{
  "name": "guildnest",
  "version": "0.1.0",
  "private": true,
  "description": "GuildNest modular Discord management platform and NestMate bot",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace @guildnest/bot",
    "start:bot": "npm run start --workspace @guildnest/bot",
    "register:commands": "npm run register:commands --workspace @guildnest/bot",
    "typecheck:bot": "npm run typecheck --workspace @guildnest/bot",
    "dev:web": "npm run dev --workspace @guildnest/web",
    "build:web": "npm run build --workspace @guildnest/web",
    "start:web": "npm run start --workspace @guildnest/web",
    "typecheck:web": "npm run typecheck --workspace @guildnest/web"
  },
  "engines": {
    "node": ">=20"
  }
}
